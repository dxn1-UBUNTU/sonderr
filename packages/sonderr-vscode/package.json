      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo9",
        "title": "Agent Manager: Jump to Item 9",
        "category": "Sonderr"
      },
      {
        "command": "sonderr-code.new.generateCommitMessage",
        "title": "Generate Commit Message",
        "category": "Sonderr",
        "icon": {
          "light": "assets/icons/sonderr-light.svg",
          "dark": "assets/icons/sonderr-dark.svg"
        }
      },
      {
        "command": "sonderr-code.new.explainCode",
        "title": "Explain Code",
        "category": "Sonderr"
      },
      {
        "command": "sonderr-code.new.fixCode",
        "title": "Fix Code",
