{
  "name": "sonderr-code",
  "displayName": "Sonderr: AI Coding Agent, Copilot, and Autocomplete",
  "description": "Open Source AI coding agent that generates code from natural language, automates tasks, and runs terminal commands. Features inline autocomplete, browser automation, automated refactoring, and custom modes for planning, coding, and debugging. Supports 500+ AI models including Claude (Anthropic), Gemini, Grok, GPT, Codex and GLM.",
  "version": "7.5.6",
  "icon": "assets/icons/logo-outline-black.png",
  "galleryBanner": {
    "color": "#FFFFFF",
    "theme": "light"
  },
  "publisher": "sonderr",
  "repository": {
    "type": "git",
    "url": "https://github.com/Sonderr-Org/sonderr.git",
    "directory": "packages/sonderr-vscode"
  },
  "engines": {
    "vscode": "^1.105.1"
  },
  "license": "MIT",
  "author": {
    "name": "Sonderr"
  },
  "categories": [
    "AI",
    "Chat",
    "Programming Languages",
    "Education",
    "Snippets",
    "Testing"
  ],
  "keywords": [
    "sonderr",
    "Sonderr",
    "sonderr",
    "ai",
    "agent",
    "agentic",
    "coding",
    "coding agent",
    "coding assistant",
    "autocomplete",
    "code completion",
    "pair programming",
    "chat",
    "terminal",
    "chatgpt",
    "claude",
    "sonnet",
    "anthropic",
    "openai",
    "zoo code",
    "sonderr",
    "open code"
  ],
  "activationEvents": [
    "onStartupFinished",
    "onUri"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "configurationDefaults": {
      "files.watcherExclude": {
        "**/.sonderr/worktrees/**": true,
        "**/.sonderr/worktrees/**": true
      }
    },
    "taskDefinitions": [
      {
        "type": "sonderr-worktree-setup",
        "properties": {
          "script": {
            "type": "string",
            "description": "The setup script command to execute"
          }
        }
      }
    ],
    "icons": {
      "sonderr-logo": {
        "description": "Sonderr logo",
        "default": {
          "fontPath": "assets/icons/sonderr-icon-font.woff2",
          "fontCharacter": "\\F101"
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "sonderr-code-ActivityBar",
          "title": "Sonderr",
          "icon": "assets/icons/sonderr-light.png",
          "darkIcon": "assets/icons/sonderr-dark.png"
        }
      ]
    },
    "views": {
      "sonderr-code-ActivityBar": [
        {
          "type": "webview",
          "id": "sonderr-code.SidebarProvider",
          "name": "Sonderr"
        }
      ]
    },
    "commands": [
      {
        "command": "sonderr-code.new.plusButtonClicked",
        "title": "New Task",
        "category": "Sonderr",
        "icon": "$(add)"
      },
      {
        "command": "sonderr-code.new.agentManagerOpen",
        "title": "Agent Manager",
        "category": "Sonderr",
        "icon": "$(organization)"
      },
      {
        "command": "sonderr-code.new.sonderrClawOpen",
        "title": "SonderrClaw",
        "category": "Sonderr",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sonderr-code.new.marketplaceButtonClicked",
        "title": "Marketplace",
        "category": "Sonderr",
        "icon": "$(extensions)"
      },
      {
        "command": "sonderr-code.new.historyButtonClicked",
        "title": "History",
        "category": "Sonderr",
        "icon": "$(history)"
      },
      {
        "command": "sonderr-code.new.profileButtonClicked",
        "title": "Profile",
        "category": "Sonderr",
        "icon": "$(account)"
      },
      {
        "command": "sonderr-code.new.settingsButtonClicked",
        "title": "Settings",
        "category": "Sonderr",
        "icon": "$(settings-gear)"
      },
      {
        "command": "sonderr-code.new.sidebarTitle.plusButtonClicked",
        "title": "New Task",
        "icon": "$(add)"
      },
      {
        "command": "sonderr-code.new.sidebarTitle.agentManagerOpen",
        "title": "Agent Manager",
        "icon": "$(organization)"
      },
      {
        "command": "sonderr-code.new.sidebarTitle.sonderrClawOpen",
        "title": "SonderrClaw",
        "icon": "$(comment-discussion)"
      },
      {
        "command": "sonderr-code.new.sidebarTitle.marketplaceButtonClicked",
        "title": "Marketplace",
        "icon": "$(extensions)"
      },
