    "submenus": [
      {
        "id": "sonderr-code.new.editorContextMenu",
        "label": "Sonderr"
      },
      {
        "id": "sonderr-code.new.terminalContextMenu",
        "label": "Sonderr"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "sonderr-code.new.sidebarTitle.plusButtonClicked",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.historyButtonClicked",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.agentManagerOpen",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.sonderrClawOpen",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.agentManager.advancedWorktree",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.marketplaceButtonClicked",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.profileButtonClicked",
          "when": "false"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.settingsButtonClicked",
          "when": "false"
        }
      ],
      "view/title": [
        {
          "command": "sonderr-code.new.sidebarTitle.plusButtonClicked",
          "group": "navigation@0",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.historyButtonClicked",
          "group": "navigation@1",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.agentManagerOpen",
          "group": "navigation@2",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.sonderrClawOpen",
          "group": "navigation@3",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.marketplaceButtonClicked",
          "group": "navigation@4",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.profileButtonClicked",
          "group": "navigation@5",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.sidebarTitle.settingsButtonClicked",
          "group": "navigation@6",
          "when": "view == sonderr-code.SidebarProvider && !sonderr-code.new.isCursor"
        }
      ],
      "scm/title": [
        {
          "command": "sonderr-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "scm/input": [
        {
          "command": "sonderr-code.new.generateCommitMessage",
          "group": "navigation",
          "when": "scmProvider == git"
        }
      ],
      "editor/title": [
        {
          "command": "sonderr-code.new.openInTab",
          "group": "navigation",
          "when": "true"
        },
        {
          "command": "sonderr-code.new.plusButtonClicked",
          "group": "navigation@0",
          "when": "activeWebviewPanelId == sonderr-code.new.TabPanel && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.historyButtonClicked",
          "group": "navigation@1",
          "when": "activeWebviewPanelId == sonderr-code.new.TabPanel && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.profileButtonClicked",
          "group": "navigation@2",
          "when": "activeWebviewPanelId == sonderr-code.new.TabPanel && !sonderr-code.new.isCursor"
        },
        {
          "command": "sonderr-code.new.settingsButtonClicked",
          "group": "navigation@3",
          "when": "activeWebviewPanelId == sonderr-code.new.TabPanel && !sonderr-code.new.isCursor"
        }
      ],
      "editor/context": [
        {
          "submenu": "sonderr-code.new.editorContextMenu",
          "group": "1_sonderr"
        }
      ],
      "sonderr-code.new.editorContextMenu": [
        {
          "command": "sonderr-code.new.explainCode",
          "group": "1_actions@1"
        },
        {
          "command": "sonderr-code.new.fixCode",
          "group": "1_actions@2"
        },
        {
          "command": "sonderr-code.new.improveCode",
          "group": "1_actions@3"
        },
        {
          "command": "sonderr-code.new.addToContext",
          "group": "1_actions@4"
        }
      ],
      "terminal/context": [
        {
          "submenu": "sonderr-code.new.terminalContextMenu",
          "group": "2_sonderr"
        }
      ],
      "sonderr-code.new.terminalContextMenu": [
        {
          "command": "sonderr-code.new.terminalAddToContext",
          "group": "1_actions@1"
        },
        {
          "command": "sonderr-code.new.terminalFixCommand",
          "group": "1_actions@2"
        },
        {
          "command": "sonderr-code.new.terminalExplainCommand",
          "group": "1_actions@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sonderr-code.new.focusChatInput",
        "key": "ctrl+shift+a",
        "mac": "cmd+shift+a"
      },
      {
        "command": "sonderr-code.new.toggleAutoApprove",
        "key": "ctrl+alt+a",
        "mac": "cmd+alt+a"
      },
      {
        "command": "sonderr-code.new.generateTerminalCommand",
        "key": "ctrl+shift+g",
        "mac": "cmd+shift+g"
      },
      {
        "command": "-workbench.actions.view.problems",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "sonderr-code.new.agentManagerOpen",
        "key": "ctrl+shift+m",
        "mac": "cmd+shift+m"
      },
      {
        "command": "sonderr-code.new.addToContext",
        "key": "ctrl+k ctrl+a",
        "mac": "cmd+k cmd+a",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "sonderr-code.new.agentManager.previousSession",
        "key": "ctrl+alt+up",
        "mac": "cmd+alt+up",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.nextSession",
        "key": "ctrl+alt+down",
        "mac": "cmd+alt+down",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.previousTab",
        "key": "ctrl+alt+left",
        "mac": "cmd+alt+left",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.nextTab",
        "key": "ctrl+alt+right",
        "mac": "cmd+alt+right",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.previousTerminal",
        "key": "ctrl+shift+[",
        "mac": "cmd+shift+[",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.nextTerminal",
        "key": "ctrl+shift+]",
        "mac": "cmd+shift+]",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.search",
        "key": "ctrl+f",
        "mac": "cmd+f",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && !terminalFocus"
      },
      {
        "command": "sonderr-code.new.agentManager.showTerminal",
        "key": "ctrl+/",
        "mac": "cmd+/",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && !sonderr-code.new.sidebarFocused"
      },
      {
        "command": "sonderr-code.new.agentManager.runScript",
        "key": "ctrl+e",
        "mac": "cmd+e",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && (isMac || !terminalFocus)"
      },
      {
        "command": "sonderr-code.new.agentManager.toggleDiff",
        "key": "ctrl+d",
        "mac": "cmd+d",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.showShortcuts",
        "key": "ctrl+shift+/",
        "mac": "cmd+shift+/",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.newTab",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && !sonderr-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "sonderr-code.new.agentManager.newTerminalTab",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && !sonderr-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "sonderr-code.new.agentManager.newSideTerminal",
        "key": "ctrl+t",
        "mac": "cmd+t",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' && sonderr-code.new.agentManagerSideTerminalFocused"
      },
      {
        "command": "sonderr-code.new.agentManager.closeTab",
        "key": "ctrl+w",
        "mac": "cmd+w",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.newWorktree",
        "key": "ctrl+n",
        "mac": "cmd+n",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.quickWorktree",
        "key": "ctrl+shift+n",
        "mac": "cmd+shift+n",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.openWorktree",
        "key": "ctrl+shift+o",
        "mac": "cmd+shift+o",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.openPR",
        "key": "ctrl+shift+r",
        "mac": "cmd+shift+r",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.closeWorktree",
        "key": "ctrl+shift+w",
        "mac": "cmd+shift+w",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo1",
        "key": "ctrl+1",
        "mac": "cmd+1",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo2",
        "key": "ctrl+2",
        "mac": "cmd+2",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo3",
        "key": "ctrl+3",
        "mac": "cmd+3",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo4",
        "key": "ctrl+4",
        "mac": "cmd+4",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo5",
        "key": "ctrl+5",
        "mac": "cmd+5",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo6",
        "key": "ctrl+6",
        "mac": "cmd+6",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo7",
        "key": "ctrl+7",
        "mac": "cmd+7",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo8",
        "key": "ctrl+8",
        "mac": "cmd+8",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.agentManager.jumpTo9",
        "key": "ctrl+9",
        "mac": "cmd+9",
        "when": "activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel'"
      },
      {
        "command": "sonderr-code.new.cycleAgentMode",
        "key": "ctrl+.",
        "mac": "cmd+.",
        "when": "sonderr-code.new.sidebarFocused || activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' || activeWebviewPanelId == 'sonderr-code.new.TabPanel'"
      },
      {
        "command": "sonderr-code.new.cyclePreviousAgentMode",
        "key": "ctrl+shift+.",
        "mac": "cmd+shift+.",
        "when": "sonderr-code.new.sidebarFocused || activeWebviewPanelId == 'sonderr-code.new.AgentManagerPanel' || activeWebviewPanelId == 'sonderr-code.new.TabPanel'"
      },
      {
        "command": "sonderr-code.new.autocomplete.cancelSuggestions",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && sonderr-code.new.autocomplete.hasSuggestions"
      },
      {
        "command": "sonderr-code.new.autocomplete.generateSuggestions",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && sonderr.autocomplete.enableSmartInlineTaskKeybinding && !github.copilot.completions.enabled"
      },
      {
        "command": "sonderr-code.new.autocomplete.showIncompatibilityExtensionPopup",
        "key": "ctrl+l",
        "mac": "cmd+l",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && sonderr.autocomplete.enableSmartInlineTaskKeybinding && github.copilot.completions.enabled"
      },
      {
        "command": "sonderr-code.new.autocomplete.nextEdit.acceptOrJump",
        "key": "tab",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && !suggestWidgetVisible && sonderr-code.nextEdit.hasPendingSuggestion"
      },
      {
        "command": "sonderr-code.new.autocomplete.nextEdit.dismiss",
        "key": "escape",
        "when": "editorTextFocus && !editorTabMovesFocus && !inSnippetMode && sonderr-code.nextEdit.hasPendingSuggestion"
      }
    ],
