      },
      {
        "command": "sonderr-code.new.generateTerminalCommand",
        "title": "Generate Terminal Command",
        "category": "Sonderr"
      },
      {
        "command": "sonderr-code.new.takeHeapSnapshot",
        "title": "Take Heap Snapshot",
