        "category": "Sonderr"
      },
      {
        "command": "sonderr-code.new.agentManager.search",
        "title": "Agent Manager: Search Worktrees and Sessions",
        "category": "Sonderr"
      },
      {
        "command": "sonderr-code.new.agentManager.showTerminal",
        "title": "Agent Manager: Focus Terminal",
        "category": "Sonderr",
        "icon": "$(terminal)"
      },
      {
        "command": "sonderr-code.new.agentManager.runScript",
        "title": "Agent Manager: Run Script",
        "category": "Sonderr",
        "icon": "$(play)"
      },
      {
        "command": "sonderr-code.new.agentManager.toggleDiff",
        "title": "Agent Manager: Toggle Diff Panel",
        "category": "Sonderr",
        "icon": "$(diff)"
      },
      {
        "command": "sonderr-code.new.agentManager.showShortcuts",
